# Copy to .env and fill in only the providers you use. Never commit .env.

# Which provider to use: ollama (default, local), openai or groq.
SCHEMA_ENGINE_PROVIDER=ollama
# Leave empty to use the provider's default model.
SCHEMA_ENGINE_MODEL=
# Request timeout in seconds.
SCHEMA_ENGINE_TIMEOUT=60

OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
